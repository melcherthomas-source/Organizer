{
  "name": "werkstatt-todo",
  "version": "1.0.0",
  "description": "Aufgaben und Rückrufe",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.werkstatt.todo",
    "productName": "Werkstatt Todo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
